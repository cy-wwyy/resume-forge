{
  "name": "resume-forge",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,magenta \"vite\" \"tsx watch server/index.ts\"",
    "dev:web": "vite",
    "dev:api": "tsx watch server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check:export": "node scripts/check-export.mjs",
    "check": "npm run typecheck && node scripts/check-ui.mjs && node scripts/check-export.mjs",
    "dev:lan": "concurrently -n web,api -c cyan,magenta \"vite --host\" \"tsx watch server/index.ts\"",
    "build:subpath": "VITE_BASE=/resume/ vite build",
    "deploy": "bash scripts/deploy-remote.sh"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.6",
    "fflate": "^0.8.2",
    "hono": "^4.10.7",
    "html-to-image": "^1.11.13",
    "idb-keyval": "^6.2.2",
    "immer": "^10.2.0",
    "jspdf": "^3.0.4",
    "lucide-react": "^0.554.0",
    "playwright-core": "1.65.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.2.2"
  }
}
